# Authentication Routes


###
# Register a new user
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "testuser@example.com",
  "password": "password123",
  "photoUrl": "https://example.com/photo.jpg"
}


###
# Login with username or email
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "password123"
}


###
# Login with email instead of username
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "password123"
}


###
# Sign in with Google
POST http://localhost:3000/auth/google
Content-Type: application/json

{
  "credential": "GOOGLE_CREDENTIAL_TOKEN"
}


###
# Refresh access token
POST http://localhost:3000/auth/refresh
Content-Type: application/json

{
  "refreshToken": "REFRESH_TOKEN"
}


###
# Logout (invalidate refresh token)
POST http://localhost:3000/auth/logout
Content-Type: application/json

{
  "refreshToken": "REFRESH_TOKEN"
}


# User Routes


###
# Get current authenticated user
GET http://localhost:3000/user/whoami
Authorization: Bearer ACCESS_TOKEN


###
# Create a new user
POST http://localhost:3000/user
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "username": "john_doe",
  "email": "john@example.com",
  "password": "password123"
}


###
# Get all users
GET http://localhost:3000/user
Authorization: Bearer ACCESS_TOKEN


###
# Get user by ID
GET http://localhost:3000/user/USER_ID
Authorization: Bearer ACCESS_TOKEN


###
# Update user profile
PATCH http://localhost:3000/user/USER_ID
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "username": "john_updated",
  "email": "john.updated@example.com",
  "password": "newpassword123",
  "photoUrl": "https://example.com/new-photo.jpg"
}


###
# Delete user
DELETE http://localhost:3000/user/USER_ID
Authorization: Bearer ACCESS_TOKEN


# Post Routes


###
# Create a new post
POST http://localhost:3000/post
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "content": "This is my first post!"
}


###
# Get all posts
GET http://localhost:3000/post
Authorization: Bearer ACCESS_TOKEN


###
# Get posts by user
GET http://localhost:3000/post?user=USER_ID
Authorization: Bearer ACCESS_TOKEN


###
# Get posts by specific user
GET http://localhost:3000/post?user=USER_ID&page=1
Authorization: Bearer ACCESS_TOKEN


###
# Get post by ID
GET http://localhost:3000/post/POST_ID
Authorization: Bearer ACCESS_TOKEN


###
# Update post content
PUT http://localhost:3000/post/POST_ID
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "content": "Updated post content!"
}


###
# Toggle like on a post
POST http://localhost:3000/post/POST_ID/like
Authorization: Bearer ACCESS_TOKEN


###
# Toggle save on a post
POST http://localhost:3000/post/POST_ID/save
Authorization: Bearer ACCESS_TOKEN


###
# Get all posts liked by a user
GET http://localhost:3000/post/user/USER_ID/liked
Authorization: Bearer ACCESS_TOKEN


###
# Get all posts saved by a user
GET http://localhost:3000/post/user/USER_ID/saved
Authorization: Bearer ACCESS_TOKEN


###
# Delete post
DELETE http://localhost:3000/post/POST_ID
Authorization: Bearer ACCESS_TOKEN


# Comment Routes


###
# Create a new comment
POST http://localhost:3000/comment
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "post": "POST_ID",
  "content": "Great post!"
}


###
# Get all comments
GET http://localhost:3000/comment
Authorization: Bearer ACCESS_TOKEN


###
# Get comments by user
GET http://localhost:3000/comment?user=USER_ID
Authorization: Bearer ACCESS_TOKEN


###
# Get comments by post ID (using postId parameter)
GET http://localhost:3000/comment/post?postId=POST_ID
Authorization: Bearer ACCESS_TOKEN


###
# Get comment by ID
GET http://localhost:3000/comment/COMMENT_ID
Authorization: Bearer ACCESS_TOKEN


###
# Update comment
PUT http://localhost:3000/comment/COMMENT_ID
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "content": "Updated comment content!"
}


###
# Delete comment
DELETE http://localhost:3000/comment/COMMENT_ID
Authorization: Bearer ACCESS_TOKEN


# Upload Routes


###
# Upload an image
POST http://localhost:3000/upload
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="image"; filename="photo.jpg"
Content-Type: image/jpeg

< ../public/images/1772213896925-823670813.jpg
--UploadBoundary--


# AI Routes


###
# Generate initial post draft with optional images
POST http://localhost:3000/api/ai/generateInitialDraft
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "prompt": "Write a short post about React hooks",
  "includeImages": true
}


###
# Generate draft without images
POST http://localhost:3000/api/ai/generateInitialDraft
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "prompt": "Write a short post about React hooks",
  "includeImages": false
}


###
# Refine existing text with an instruction
POST http://localhost:3000/api/ai/refineText
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "currentText": "This is a long and verbose draft that should be shortened and made more concise.",
  "instruction": "Make it concise and friendly"
}


###
# Get more images for a keyword
POST http://localhost:3000/api/ai/getMoreImages
Content-Type: application/json
Authorization: Bearer ACCESS_TOKEN

{
  "keyword": "nature"
}